rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Altas Nuevas · Control y Verificación
    // Cualquier usuario autenticado (email/password) puede leer y escribir.
    // No hay roles por departamento todavía (ver README.md, sección "Roles").
    match /altas_tracker/{altaId} {
      allow read, write: if request.auth != null;
    }

    match /stock_general/{materialId} {
      allow read, write: if request.auth != null;
    }

    // Deniega todo lo demás por defecto, incluida cualquier colección
    // de otras apps (ej. Aldelís Muelles) que compartan este proyecto Firebase.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
